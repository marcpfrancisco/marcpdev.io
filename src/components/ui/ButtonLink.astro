---
/**
 * Square, document-like link button. One `primary` (cobalt, black text) per page; everything else
 * is `secondary` (hairline). States: hover, active, focus-visible (global ring).
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'secondary', class: className, ...rest } = Astro.props;
const isExternal = /^https?:\/\//.test(href);
---

<a
  href={href}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class:list={[
    'inline-flex min-h-12 items-center gap-xs px-lg text-md no-underline transition-colors duration-(--dur-short) ease-out',
    variant === 'primary' &&
      'bg-accent text-accent-ink hover:bg-ink active:bg-ink-2 active:duration-(--dur-micro)',
    variant === 'secondary' &&
      'border border-rule-strong text-ink hover:border-accent active:bg-paper-2 active:duration-(--dur-micro)',
    className,
  ]}
  {...rest}
>
  <slot />
</a>
