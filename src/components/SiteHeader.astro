---
import { contactAction, primaryNav } from '../data/navigation';
import { person } from '../data/site';
import Icon from './Icon.astro';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  return current === href || current.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-(--z-sticky-nav) h-(--header-h) border-b border-rule bg-paper">
  <div class="container-page flex h-full items-center justify-between gap-lg">
    <a
      href="/"
      class="inline-flex min-h-11 items-center font-display text-lg leading-none tracking-section text-ink no-underline"
      aria-label={`${person.name}, home`}
    >
      {person.name}
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-xl md:flex">
      <ul class="flex items-center gap-lg">
        {primaryNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="inline-flex min-h-11 items-center text-sm text-ink-2 no-underline transition-colors duration-(--dur-short) ease-out hover:text-ink active:text-accent aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-accent"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={contactAction.href}
        class="inline-flex min-h-11 items-center border border-rule-strong px-md text-sm text-ink no-underline transition-colors duration-(--dur-short) ease-out hover:border-accent active:bg-paper-2"
      >
        {contactAction.label}
      </a>
    </nav>

    <button
      type="button"
      popovertarget="mobile-nav"
      class="inline-flex size-11 items-center justify-center text-ink md:hidden"
    >
      <Icon name="menu" class="text-lg" />
      <span class="visually-hidden">Open menu</span>
    </button>
  </div>

  <nav
    id="mobile-nav"
    popover
    aria-label="Primary"
    class="m-0 h-dvh w-full max-w-none border-0 bg-paper p-0 text-ink md:hidden"
  >
    <div class="container-page flex h-(--header-h) items-center justify-between">
      <span class="font-display text-lg leading-none">{person.name}</span>
      <button
        type="button"
        popovertarget="mobile-nav"
        popovertargetaction="hide"
        class="inline-flex size-11 items-center justify-center"
      >
        <Icon name="close" class="text-lg" />
        <span class="visually-hidden">Close menu</span>
      </button>
    </div>
    <ul class="container-page flex flex-col border-t border-rule pt-lg">
      {primaryNav.map((item) => (
        <li class="border-b border-rule">
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="flex min-h-14 items-center justify-between font-display text-title text-ink no-underline"
          >
            {item.label}
            <span class="file-mono text-muted">{item.code}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="container-page pt-xl">
      <a
        href={contactAction.href}
        class="inline-flex min-h-12 items-center border border-rule-strong px-lg text-ink no-underline"
      >
        {contactAction.label}
      </a>
    </div>
  </nav>
</header>
