# ---------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------
node_modules/
.pnpm-store/
# package-lock.json IS committed (reproducible installs, npm audit).

# ---------------------------------------------------------------
# Build output and generated files
# ---------------------------------------------------------------
dist/
.astro/
.vercel/
.netlify/
*.tsbuildinfo
.eslintcache
.prettiercache
coverage/

# ---------------------------------------------------------------
# Environment and secrets: never commit real values
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.kdbx
credentials*.json
secrets*.json
service-account*.json
id_rsa*
id_ed25519*

# ---------------------------------------------------------------
# Private Anvil content that must never leave this machine.
# Name a file *.private.md / *.private.mdx, or put it in a _private/
# folder, to keep it out of git entirely (stronger than public: false,
# which only keeps it out of the public build).
# ---------------------------------------------------------------
*.private.md
*.private.mdx
**/_private/

# Lab runtime data (docker volumes, n8n local data, captures, loot)
src/content/ai-automation/**/data/
src/content/ai-automation/**/.n8n/
src/content/ai-automation/**/volumes/
*.pcap
*.pcapng
*.ovpn
loot/

# ---------------------------------------------------------------
# Logs and debug output
# ---------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lighthouse*.html
lighthouse*.json

# ---------------------------------------------------------------
# OS files
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------
# Editors: share only recommended extensions
# ---------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~

# ---------------------------------------------------------------
# Claude Code: commit project skills, never local settings
# ---------------------------------------------------------------
.claude/settings.local.json
CLAUDE.local.md

# ---------------------------------------------------------------
# graphify: commit graph.json, GRAPH_REPORT.md and manifest.json
# (shared map for agents + incremental --update); drop the rest
# ---------------------------------------------------------------
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/manifest.json

# ---------------------------------------------------------------
# Scratch
# ---------------------------------------------------------------
tmp/
*.tmp

# Hallmark design-lint screenshots (regenerated on every sweep)
.hallmark/shots/

# Private originals that must never ship or be committed (e.g. resumes with a phone number)
private/
